---
import Layout from "../../layouts/Layout.astro";
import Indice from "../../components/IndiceBases2.astro";

const tarjetas = [
  {
    "titulo": "SQL avanzado",
    "url": "/evidencias/bases-de-datos-2/sql-avanzado/",
    "detalle": "Transacciones, concurrencia e índices en Oracle.",
    "muestra": "SELECT saldo\nFROM cuenta\nFOR UPDATE;"
  },
  {
    "titulo": "PL/SQL",
    "url": "/evidencias/bases-de-datos-2/pl-sql/",
    "detalle": "Procedimientos y pruebas para gestionar inventarios.",
    "muestra": "DECLARE\n  v_id_prod NUMBER;\nBEGIN"
  },
  {
    "titulo": "NoSQL",
    "url": "/evidencias/bases-de-datos-2/nosql/",
    "detalle": "Consultas y modelado de documentos en MongoDB.",
    "muestra": "db.movies.find({\n  genres: \"Drama\"\n})"
  }
];
---
<Layout title="Bases de Datos 2">
  <Indice titulo="Bases de Datos 2" volver="/evidencias/" anterior="Volver a Evidencias" tarjetas={tarjetas} />
</Layout>
