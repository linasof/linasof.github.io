---
import Layout from "../../layouts/Layout.astro";

const allPosts = Object.values(
  import.meta.glob("../posts/*.md", { eager: true }),
);
const posts = allPosts.filter(
  (post: any) => post.frontmatter?.categoria === "modelado",
);
---

<Layout title="Modelado">
  <section class="py-20 px-5">
    <div class="max-w-4xl mx-auto">
      <a href="/evidencias/bases-de-datos-1" class="text-white underline mb-5 inline-block">← Volver a Bases de Datos 1</a>
      <h1 class="text-5xl font-black mb-10 text-white">Modelado</h1>
      <div class="space-y-5">
        {posts.map(({ url, frontmatter }: any) => (
          <a href={url} class="flex flex-col sm:flex-row gap-5 sm:items-center rounded-xl bg-neutral-950 p-5 border border-white/30 transition-all duration-200 hover:shadow-[4px_4px_0px_rgba(255,255,255,0.3)]">
            <div class="w-full sm:w-[200px] h-[130px] overflow-hidden border-2 flex-shrink-0">
              <img src={frontmatter?.image?.url} alt={frontmatter.title} class="w-full h-full object-contain bg-white" />
            </div>
            <div>
              <h2 class="text-xl font-bold text-white">{frontmatter.title}</h2>
              <p class="text-gray-300 text-sm mt-1">{frontmatter.descripcion}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>