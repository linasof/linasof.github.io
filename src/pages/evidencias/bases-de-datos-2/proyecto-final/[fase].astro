---
import Layout from "../../../../layouts/Layout.astro";
import fases from "../../../../data/bountyline-fases.json";
import {readFileSync} from "node:fs";
export function getStaticPaths() {
  return fases.map(fase => ({params: {fase: fase.slug}, props: {fase}}));
}
const {fase} = Astro.props;
---
<Layout title={fase.titulo + " · BountyLine"}>
  <article class="mx-auto w-full min-w-0 max-w-5xl px-5 py-12 text-white">
    <a href="/evidencias/bases-de-datos-2/proyecto-final/" class="underline">← Volver a BountyLine</a>
    <h1 class="my-8 text-4xl font-black">{fase.titulo}</h1>
    {fase.secciones.map(seccion => (
      <section class="my-8">
        <h2 class="mb-4 text-2xl font-bold">{seccion.nombre}</h2>
        {seccion.docs.map(doc => (
          <details class="my-2 rounded-xl border border-white/25 bg-neutral-950 p-4">
            <summary class="cursor-pointer font-semibold">{doc.titulo}</summary>
            {doc.tipo === "pdf" ? <iframe loading="lazy" title={doc.titulo} src={doc.url + "#view=FitH"} class="my-4 h-[68vh] w-full"></iframe>
              : doc.tipo === "png" ? <img loading="lazy" src={doc.url} alt={doc.titulo} class="my-4 w-full rounded-lg"/>
              : <pre tabindex="0" class="my-4 max-h-[60vh] overflow-auto p-3 text-sm"><code>{readFileSync("public"+doc.url,"utf8")}</code></pre>}
            <a class="underline" href={doc.url} download={["sql","js"].includes(doc.tipo)}> {["sql","js"].includes(doc.tipo) ? "Descargar script" : "Abrir archivo completo"} </a>
          </details>
        ))}
      </section>
    ))}
    {fase.slug === "fase-2" && <section class="space-y-4">
      <h2 class="text-2xl font-bold">BountyLine en funcionamiento</h2>
      <iframe loading="lazy" class="aspect-video w-full" title="Demostración de BountyLine" src="https://www.youtube-nocookie.com/embed/qVt9Vf7JouA" allowfullscreen></iframe>
      <div class="flex flex-wrap gap-5 underline"><a href="https://youtu.be/qVt9Vf7JouA">Ver en YouTube</a><a href="https://github.com/gabGABY006/BountyLine">Repositorio del proyecto</a></div>
    </section>}
  </article>
</Layout>
