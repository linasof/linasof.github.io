---
import Layout from "../layouts/Layout.astro";
import Container from "../components/elements/Container.astro";

const cursos = [
  {
    nombre: "Bases de Datos 1",
    imagen: "/portada-bases-1.png",
    url: "/evidencias/bases-de-datos-1",
  },
  {
    nombre: "Bases de Datos 2",
    imagen: "/portada-bases-2.png",
    url: "/evidencias/bases-de-datos-2",
  },
];
---

<Layout title="Evidencias">
  <Container variant="lg">
    <section class="w-full">
      <h1 class="text-center text-5xl font-black text-white">
        Evidencias
      </h1>

      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
        {cursos.map((curso) => (
          <a
            href={curso.url}
            class="block overflow-hidden rounded-xl border border-white/30 bg-neutral-950 hover:border-white/60 focus-visible:outline-4 focus-visible:outline-yellow-400"
          >
            <div class="relative isolate aspect-[3/2] overflow-hidden bg-neutral-900">
              <img
                src={curso.imagen}
                alt=""
                aria-hidden="true"
                class="absolute inset-0 h-full w-full scale-110 object-cover opacity-35 blur-xl"
              />
              <img
                src={curso.imagen}
                alt=""
                class="relative h-full w-full object-contain"
              />
            </div>

            <h2 class="border-t border-white/20 px-5 py-4 text-2xl font-bold text-white">
              {curso.nombre}
            </h2>
          </a>
        ))}
      </div>
    </section>
  </Container>
</Layout>