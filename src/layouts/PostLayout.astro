---
import Layout from "./Layout.astro";
const { frontmatter } = Astro.props;
const imagenes = frontmatter.imagenes || [];
---

<Layout title={frontmatter.title}>
  <section class="py-20 px-5">
    <div class="max-w-5xl mx-auto">
      <a href="/evidencias/modelado" class="text-yellow-600 mb-5 inline-block">← Volver a Modelado</a>
      <h1 class="text-4xl font-black mb-4 text-white">{frontmatter.title}</h1>

{frontmatter.links && (
  <div class="flex flex-wrap gap-3 mb-10">
    {frontmatter.links.map((l: any) => (
      <a href={l.url} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-yellow-400 hover:text-yellow-300 underline text-sm font-medium">
        📄 Ver documento: {l.nombre}
      </a>
    ))}
  </div>
)}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {imagenes.map((img: any, i: number) => (
          <button data-index={i} class="lightbox-trigger flex flex-col bg-white/10 border border-white/20 p-3 group text-left transition-all hover:bg-white/20 rounded-xl">
            <div class="w-full h-[200px] overflow-hidden rounded-lg pointer-events-none">
              <img src={img.url} alt={img.nombre} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            </div>
            <p class="mt-2 text-sm font-medium text-white pointer-events-none">{img.nombre}</p>
          </button>
        ))}
      </div>
    </div>
  </section>

  <div id="lightbox" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-sm items-center justify-center p-4">
    <button id="btn-close" class="absolute top-5 right-6 text-white text-4xl font-bold hover:opacity-70">✕</button>
    <button id="btn-prev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white text-5xl font-bold hover:opacity-70">‹</button>
    <button id="btn-next" class="absolute right-6 top-1/2 -translate-y-1/2 text-white text-5xl font-bold hover:opacity-70">›</button>
    <div class="flex flex-col items-center gap-4 max-w-4xl w-full pointer-events-none">
      <img id="lightbox-img" src="" alt="" class="max-h-[80vh] w-auto rounded object-contain shadow-2xl" />
      <p id="lightbox-caption" class="text-white text-center text-lg font-semibold"></p>
    </div>
  </div>

  <script define:vars={{ imagenes }}>
    let current = 0;

    function update() {
      document.getElementById("lightbox-img").src = imagenes[current].url;
      document.getElementById("lightbox-caption").textContent = imagenes[current].nombre;
    }

    function show(visible) {
      const lb = document.getElementById("lightbox");
      lb.classList.toggle("hidden", !visible);
      lb.classList.toggle("flex", visible);
      document.body.style.overflow = visible ? "hidden" : "";
    }

    document.querySelectorAll(".lightbox-trigger").forEach((btn) => {
      btn.addEventListener("click", () => {
        current = parseInt(btn.getAttribute("data-index"));
        update();
        show(true);
      });
    });

    document.getElementById("btn-close").addEventListener("click", () => show(false));
    document.getElementById("btn-prev").addEventListener("click", () => {
      current = (current - 1 + imagenes.length) % imagenes.length;
      update();
    });
    document.getElementById("btn-next").addEventListener("click", () => {
      current = (current + 1) % imagenes.length;
      update();
    });

    document.getElementById("lightbox").addEventListener("click", (e) => {
      if (e.target === document.getElementById("lightbox")) show(false);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") show(false);
      if (e.key === "ArrowLeft") { current = (current - 1 + imagenes.length) % imagenes.length; update(); }
      if (e.key === "ArrowRight") { current = (current + 1) % imagenes.length; update(); }
    });
  </script>
</Layout>