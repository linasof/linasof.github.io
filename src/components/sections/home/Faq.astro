---
import Container from "../../elements/Container.astro";
import Heading from "../../elements/Heading.astro";

const categorias = [
  {
    nombre: "Modelado",
    url: "/evidencias/modelado",
    image: "/oficina.png",
    descripcion: "Representación visual de sistemas de información y conexiones entre datos.",
  },
  {
    nombre: "Normalización",
    url: "/evidencias/normalizacion",
    image: "/Normalizacion.png",
    descripcion: "Proceso que organiza los datos en tablas para evitar redundancia.",
  },
  {
    nombre: "SQL",
    url: "/evidencias/sql",
    image: "/sql.png",
    descripcion: "Lenguaje de consulta estructurado para interactuar con bases de datos.",
  },
  {
    nombre: "Algebra relacional",
   url: "/evidencias/algebra",
    image: "/algebra.png",
    descripcion: "Algebra relacional y como usarlo.",
  },
];
---

<Container variant={'lg'}>
  <section class="w-full">
    <Heading tagName="h2" tagSize="h2" class="text-center">Evidencias 🧾</Heading>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-10 mt-10">
      {categorias.map((item) => (
        <a href={item.url} class="flex flex-col group border-2 border-white p-4 transition-all duration-200 hover:shadow-[4px_4px_0px_rgba(255,255,255,0.3)]">
          <div class="w-full h-[200px] overflow-hidden border-2 border-white">
            <img src={item.image} alt={item.nombre} class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
          </div>
          <div class="pt-4 space-y-1">
            <h2 class="text-xl font-semibold text-white">{item.nombre}</h2>
            <p class="text-sm text-gray-300">{item.descripcion}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Container>