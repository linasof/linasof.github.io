---
import Container from "../../elements/Container.astro";
import Heading from "../../elements/Heading.astro";

const categorias = [
  {
    nombre: "Modelado",
    url: "/evidencias/modelado",
    image: "https://i.pinimg.com/1200x/8e/cc/8c/8ecc8cf4239853b59e9a52afa95d86ad.jpg",
    descripcion: "Representación visual de sistemas de información y conexiones entre datos.",
  },
  {
    nombre: "Normalización",
    url: "/evidencias/normalizacion",
    image: "https://blog.invgate.com/hubfs/normalizacion-de-base-de-datos.png",
    descripcion: "Proceso que organiza los datos en tablas para evitar redundancia.",
  },
  {
    nombre: "SQL",
    url: "/evidencias/sql",
    image: "https://i.pinimg.com/736x/14/20/fd/1420fdb2c1b84a55bc9a61e3050b0fa5.jpg",
    descripcion: "Lenguaje de consulta estructurado para interactuar con bases de datos.",
  },
  {
    nombre: "Proyecto",
    url: "/evidencias/proyecto",
    image: "https://i.pinimg.com/736x/93/83/59/938359e19ab1532ba2b52e8e3d4820e3.jpg",
    descripcion: "Proyecto final integrador de la materia.",
  },
];
---

<Container variant={'lg'}>
  <section class="w-full">
    <Heading tagName="h2" tagSize="h2" class="text-center">Evidencias 🧾</Heading>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-10 mt-10">
      {categorias.map((item) => (
        <a href={item.url} class="flex flex-col group border-2 border-black p-4 transition-all duration-200 hover:shadow-[4px_4px_0px_rgba(0,0,0,0.3)]">
          <div class="w-full h-[200px] overflow-hidden border-2">
            <img src={item.image} alt={item.nombre} class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
          </div>
          <div class="pt-4 space-y-1">
            <h2 class="text-xl font-semibold">{item.nombre}</h2>
            <p class="text-sm text-gray-400">{item.descripcion}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Container>