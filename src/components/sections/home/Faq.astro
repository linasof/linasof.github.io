---
import Container from "../../elements/Container.astro";
import Heading from "../../elements/Heading.astro";

const evidencias = [
  { src: "/aerolinea.jpg", nombre: "Aerolínea" },
  { src: "/biblio.png", nombre: "Biblioteca" },
  { src: "/3.jpg", nombre: "Evidencia 3" },
];
---

<Container variant={'lg'}>
  <section class="w-full">
    <Heading tagName="h2" tagSize="h2" class="text-center">Evidencias 🧾</Heading>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10 mt-10">
      {evidencias.map((item) => (
        <div class="flex flex-col items-center gap-3">
          <img
            src={item.src}
            class="w-full h-[250px] object-cover rounded-2xl shadow-xl"
          />
          <p class="text-center font-semibold text-lg">{item.nombre}</p>
        </div>
      ))}
    </div>
  </section>
</Container>