---
import Container from "../../elements/Container.astro";
import Heading from "../../elements/Heading.astro";

const evidencias = [
  { src: "/3.jpg", nombre: "Streaming" },
  { src: "/punto 1.png", nombre:"Taller MER- ER, Transporte "},
  { src: "/punto 2.png", nombre:"Taller MER- ER, Empresa de bienes raices"},
  { src: "/punto 3.png", nombre:"Taller MER- ER, Proveedor"},
  { src: "/Biblioteca.png", nombre:"Taller MER- ER, Biblioteca "},
  { src: "/Biblioteca.png", nombre:"Taller MER- ER, Biblioteca "},
  { src: "/oficina.png", nombre:"Taller MER- ER, Oficina de universidad"},
  { src: "/ultimo.png", nombre:"Taller MER- ER, Supermercados"}
];
---

<Container variant={'lg'}>
  <section class="w-full">
    <Heading tagName="h2" tagSize="h2" class="text-center">Evidencias 🧾</Heading>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10 mt-10">
      {evidencias.map((item) => (
        <div class="flex flex-col items-center gap-3">
          <button
            class="w-full group cursor-pointer border-0 bg-transparent p-0"
            onclick={`openLightbox('${item.src}', '${item.nombre}')`}
          >
            <div class="relative overflow-hidden rounded-2xl shadow-xl">
              <img
                src={item.src}
                class="w-full h-[400px] object-cover transition-transform duration-300 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center rounded-2xl">
                <span class="text-white text-sm font-semibold">🔍 Ver en detalle</span>
              </div>
            </div>
          </button>
          <p class="text-center font-semibold text-xl text-white">{item.nombre}</p>
        </div>
      ))}
    </div>
  </section>
</Container>

<!-- Lightbox Modal -->
<div
  id="lightbox"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4"
  onclick="closeLightbox(event)"
>
  <div class="relative max-w-5xl w-full flex flex-col items-center gap-4">
    <!-- Botón cerrar -->
    <button
      onclick="closeLightbox()"
      class="absolute -top-10 right-0 text-white text-3xl font-bold hover:text-gray-300 transition"
    >
      ✕
    </button>

    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-h-[85vh] w-auto rounded-2xl shadow-2xl object-contain"
    />
    <p id="lightbox-caption" class="text-white text-center text-lg font-semibold"></p>
  </div>
</div>

