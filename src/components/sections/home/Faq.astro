---
import Container from "../../elements/Container.astro";
import Heading from "../../elements/Heading.astro";

const categorias = [
  {
    nombre: "Modelado",
    url: "/evidencias/modelado",
    image: "/oficina.png",
    descripcion: "Representación visual de sistemas de información y conexiones entre datos.",
  },
  {
    nombre: "Normalización",
    url: "/evidencias/normalizacion",
    image: "/Normalizacion.png",
    descripcion: "Proceso que organiza los datos en tablas para evitar redundancia.",
  },
  {
    nombre: "SQL",
    url: "/evidencias/sql",
    image: "/sql.png",
    descripcion: "Lenguaje de consulta estructurado para interactuar con bases de datos.",
  },
  {
    nombre: "Álgebra relacional",
   url: "/evidencias/algebra",
    image: "/algebra.png",
    descripcion: "Operaciones para consultar y combinar relaciones.",
  },
];
---

<Container variant={'lg'}>
  <section class="w-full">
    <a href="/evidencias" class="mb-5 inline-block text-white underline">← Volver a Evidencias</a>
    <Heading tagName="h1" tagSize="h2" class="text-center">Bases de Datos 1</Heading>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-10">
      {categorias.map((item) => (
        <a href={item.url} class="flex flex-col group rounded-xl overflow-hidden bg-neutral-950 border border-white/30 transition-all duration-200 hover:shadow-[4px_4px_0px_rgba(255,255,255,0.3)]">
          <div class="w-full aspect-[2.4/1] overflow-hidden bg-white">
            <img src={item.image} alt={item.nombre} class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-105" />
          </div>
          <div class="p-5 space-y-2">
            <h2 class="text-xl font-semibold text-white">{item.nombre}</h2>
            <p class="text-sm text-gray-300">{item.descripcion}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Container>